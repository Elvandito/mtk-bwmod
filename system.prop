persist.vendor.radio.md_fast_wakeup=1
persist.vendor.radio.md_wakeup_latency=2
persist.vendor.radio.md_pmic_ctrl=1
persist.vendor.radio.modem_thermal_ctrl=0
persist.vendor.radio.md_off_delay=0
persist.vendor.radio.plmn_wakelock=0

# =============================================================================
# 26. MTK CONNSYS BT/GPS COEXISTENCE
# =============================================================================
persist.vendor.connsys.coex_policy=coexist
persist.vendor.connsys.bt_wlan_coex=1
persist.vendor.connsys.gps_wlan_coex=1
persist.vendor.connsys.isoc_bt_coex=0
persist.vendor.connsys.wlan_bt_timeshare=1
persist.vendor.connsys.pta_enable=1
persist.vendor.connsys.sarctrl=0

# =============================================================================
# 27. WiFi AP COMMUNICATION — QoS / WMM / 802.11 MANAGEMENT FRAMES
#     Device signals to AP to negotiate higher bandwidth and lower latency
#     via standard 802.11 ADDTS, Block ACK, beamforming, and EDCA tuning
# =============================================================================

# WMM / EDCA — map all traffic to Voice/Video AC for priority queuing
persist.vendor.mtk.wifi.wmm_ac_vo=1
persist.vendor.mtk.wifi.wmm_ac_vi=1
persist.vendor.mtk.wifi.wmm_ac_be=1
persist.vendor.mtk.wifi.wmm_ac_bk=1
persist.vendor.mtk.wifi.wmm_ps=1
persist.vendor.mtk.wifi.uapsd_enable=1

# Block ACK — enable compressed BA for higher aggregate throughput
persist.vendor.mtk.wifi.ba_tx_size=64
persist.vendor.mtk.wifi.ba_rx_size=64
persist.vendor.mtk.wifi.ba_auto=1

# ADDTS — send Traffic Stream request to AP for QoS admission
persist.vendor.mtk.wifi.addts_enable=1
persist.vendor.mtk.wifi.ts_reclassify=1
persist.vendor.mtk.wifi.ts_timeout=5000

# Beamforming feedback to AP (SU-BF + MU-BF reports)
# Device sends channel state information (CSI) to let AP aim beam
persist.vendor.mtk.wifi.su_bfer=0
persist.vendor.mtk.wifi.su_bfee=1
persist.vendor.mtk.wifi.mu_bfee=1
persist.vendor.mtk.wifi.bf_report_size=4
persist.vendor.mtk.wifi.vht_bf_cap=1
persist.vendor.mtk.wifi.he_bf_cap=1

# 802.11k — Neighbor Report (device asks AP for better AP candidates)
persist.vendor.mtk.wifi.dot11k=1
persist.vendor.mtk.wifi.rrm_enable=1
persist.vendor.mtk.wifi.beacon_report=1

# 802.11v — BSS Transition Management (AP-guided band steering + load balance)
persist.vendor.mtk.wifi.dot11v=1
persist.vendor.mtk.wifi.bss_transition=1
persist.vendor.mtk.wifi.wnm_sleep=0

# 802.11r — Fast BSS Transition (reduce roaming handshake from ~200ms to ~50ms)
persist.vendor.mtk.wifi.dot11r=1
persist.vendor.mtk.wifi.ft_over_ds=1

# Max aggregation to AP (A-MPDU / A-MSDU)
persist.vendor.mtk.wifi.max_ampdu_len=64
persist.vendor.mtk.wifi.amsdu_size=4
persist.vendor.mtk.wifi.aggr_limit=0

# Spatial streams toward AP
persist.vendor.mtk.wifi.nss_tx=2
persist.vendor.mtk.wifi.nss_rx=2
persist.vendor.mtk.wifi.he_mcs_map=0xFF

# Rate adaptation — let AP and device negotiate highest MCS
persist.vendor.mtk.wifi.rate_control=1
persist.vendor.mtk.wifi.ra_low_threshold=-75
persist.vendor.mtk.wifi.ra_high_threshold=-55
persist.vendor.mtk.wifi.ra_interval=100
